{
  "name": "boop-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BOO-P — application Android et iOS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",

    "@capacitor/ios": "8.5.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@supabase/supabase-js": "2.112.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "sharp": "0.35.4"
  }
}
